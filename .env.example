PORT=3000
# Local MongoDB, or a MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Frontend origin(s), comma-separated. "*" allows any origin.
CORS_ORIGIN=http://localhost:5500

# Used by `npm run create-admin` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
